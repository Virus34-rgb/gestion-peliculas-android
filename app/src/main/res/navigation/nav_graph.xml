<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listaFragment">

    <fragment
        android:id="@+id/listaFragment"
        android:name="com.angel.gestion_peliculas.ListaFragment"
        android:label="fragment_lista"
        tools:layout="@layout/fragment_lista" >
        <action
            android:id="@+id/action_listaFragment_to_detalleFragment"
            app:destination="@id/detalleFragment" />
        <action
            android:id="@+id/action_listaFragment_to_anadirFragment"
            app:destination="@id/anadirFragment" />
    </fragment>
    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.angel.gestion_peliculas.DetalleFragment"
        android:label="fragment_detalle"
        tools:layout="@layout/fragment_detalle" >
        <action
            android:id="@+id/action_detalleFragment_to_actualizarFragment"
            app:destination="@id/actualizarFragment" />
    </fragment>
    <fragment
        android:id="@+id/anadirFragment"
        android:name="com.angel.gestion_peliculas.anadirFragment"
        android:label="fragment_anadir"
        tools:layout="@layout/fragment_anadir" />
    <fragment
        android:id="@+id/actualizarFragment"
        android:name="com.angel.gestion_peliculas.ActualizarFragment"
        android:label="fragment_actualizar"
        tools:layout="@layout/fragment_actualizar" />
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.angel.gestion_peliculas.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_listaFragment"
            app:destination="@id/listaFragment" />
    </fragment>
</navigation>